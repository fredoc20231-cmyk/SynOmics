# Build inputs the image produces itself or never needs.
node_modules
dist
build
coverage

# VCS / CI / editor
.git
.github
.gitignore
.vscode
.idea

# Local env + secrets (never bake into an image)
.env
.env.*
!.env.example

# Python caches / Cython build artifacts
__pycache__
**/__pycache__
*.pyc
server/kernels/*.c
server/kernels/*.so
.pyxbld

# Logs / OS cruft
*.log
.DS_Store

# Docs & reports not needed at runtime
docs
legacy
*.md
!README.md
